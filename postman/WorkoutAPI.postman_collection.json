				},
				{
					"name": "Get All Exercises (Sorted)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/exercises?sort=-createdAt",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exercises"],
							"query": [ { "key": "sort", "value": "-createdAt", "description": "Newest first." } ]
						},
						"description": "Tests sort query parameter (descending)."
					}
				},
				{
					"name": "Get All Exercises (Paginated)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/exercises?page=1&limit=5",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exercises"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "5" }
							]
						},
						"description": "Tests pagination query parameters."
					}
				},
				{
					"name": "Get All Exercises (For a User)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/exercises?user={{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exercises"],
							"query": [ { "key": "user", "value": "{{userId}}", "description": "Filter exercises by owning user." } ]
						},
						"description": "Relationship demo: fetch all exercises belonging to the user created in the Users folder."
					}
				},
				{
					"name": "Get Exercise by ID",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}", "host": ["{{baseUrl}}"], "path": ["api", "exercises", "{{exerciseId}}"] },
						"description": "Fetches the exercise created earlier in this folder."
					}
				},
				{
					"name": "Update Exercise",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}", "host": ["{{baseUrl}}"], "path": ["api", "exercises", "{{exerciseId}}"] },
						"body": { "mode": "raw", "raw": "{\n  \"targetRepetitions\": 20\n}" },
						"description": "Partial update of a single field on the exercise."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "[Error] Get Exercise with Invalid ID",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/exercises/not-a-real-id", "host": ["{{baseUrl}}"], "path": ["api", "exercises", "not-a-real-id"] },
						"description": "Verifies a malformed ObjectId returns 400 (cast error)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 400 or 404', () => pm.expect(pm.response.code).to.be.oneOf([400, 404]));"
								]
							}
						}
					]
				},
				{
					"name": "[Error] Create Exercise (Invalid category enum)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/exercises", "host": ["{{baseUrl}}"], "path": ["api", "exercises"] },
						"body": { "mode": "raw", "raw": "{\n  \"description\": \"Bad category\",\n  \"category\": \"NotARealCategory\",\n  \"user\": \"{{userId}}\"\n}" },
						"description": "Verifies the enum validator rejects an unknown category."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 400', () => pm.response.to.have.status(400));"
								]
							}
						}
					]
				},
				{
					"name": "[Error] Create Exercise (Missing required field)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/exercises", "host": ["{{baseUrl}}"], "path": ["api", "exercises"] },
						"body": { "mode": "raw", "raw": "{\n  \"description\": \"No category and no user\"\n}" },
						"description": "Verifies validation rejects an exercise with no category and no user reference."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 400', () => pm.response.to.have.status(400));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Schedules",
			"description": "CRUD plus query parameters, error cases, and relationship demos for /api/schedules. Requires Users and Exercises folders to have been run first.",
			"item": [
				{
					"name": "Create New Schedule",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/schedules", "host": ["{{baseUrl}}"], "path": ["api", "schedules"] },
						"body": { "mode": "raw", "raw": "{\n  \"user\": \"{{userId}}\",\n  \"dayOfWeek\": \"Monday\",\n  \"targetBodyPart\": \"Chest\",\n  \"exercise\": \"{{exerciseId}}\",\n  \"isRestDay\": false\n}" },
						"description": "Relationship demo: creates a schedule that references both the user and exercise created earlier. Captures the new scheduleId."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"if (body && body._id) pm.collectionVariables.set('scheduleId', body._id);"
								]
							}
						}
					]
				},
				{
					"name": "Get All Schedules",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/schedules", "host": ["{{baseUrl}}"], "path": ["api", "schedules"] },
						"description": "Returns every schedule."
					}
				},
				{
					"name": "Get All Schedules (Filtered by User)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/schedules?user={{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "schedules"],
							"query": [ { "key": "user", "value": "{{userId}}", "description": "Filter schedules by owning user." } ]
						},
						"description": "Tests filter query parameter and demonstrates a relationship lookup."
					}
				},
				{
					"name": "Get All Schedules (Sorted)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/schedules?sort=dayOfWeek",
							"host": ["{{baseUrl}}"],
							"path": ["api", "schedules"],
							"query": [ { "key": "sort", "value": "dayOfWeek" } ]
						},
						"description": "Tests sort query parameter."
					}
				},
				{
					"name": "Get All Schedules (Paginated)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/schedules?page=1&limit=5",
							"host": ["{{baseUrl}}"],
							"path": ["api", "schedules"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "5" }
							]
						},
						"description": "Tests pagination query parameters."
					}
				},
				{
					"name": "Get Schedule by ID (with populated user + exercise)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/schedules/{{scheduleId}}?populate=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "schedules", "{{scheduleId}}"],
							"query": [ { "key": "populate", "value": "true", "description": "Expand user and exercise references." } ]
						},
						"description": "Relationship demo: fetches a schedule with its referenced user and exercise documents populated inline instead of returning bare ObjectIds."
					}
				},
				{
					"name": "Update Schedule",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "{{scheduleId}}"] },
						"body": { "mode": "raw", "raw": "{\n  \"dayOfWeek\": \"Wednesday\",\n  \"targetBodyPart\": \"Back\"\n}" },
						"description": "Updates the day and target body part on the schedule."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "Delete Schedule",
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{baseUrl}}/api/schedules/{{scheduleId}}", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "{{scheduleId}}"] },
						"description": "Deletes the schedule created earlier."
					}
				},
				{
					"name": "Delete Exercise",
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}", "host": ["{{baseUrl}}"], "path": ["api", "exercises", "{{exerciseId}}"] },
