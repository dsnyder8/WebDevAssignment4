					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/exercises?search=push",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exercises"],
							"query": [ { "key": "search", "value": "push", "description": "Case-insensitive regex match on description." } ]
