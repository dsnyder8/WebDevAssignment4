					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/schedules/not-a-real-id", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "not-a-real-id"] },
						"description": "Verifies a malformed ObjectId returns 400 (cast error)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 400 or 404', () => pm.expect(pm.response.code).to.be.oneOf([400, 404]));"
								]
							}
						}
					]
				},
				{
					"name": "[Error] Create Schedule (Invalid dayOfWeek enum)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/schedules", "host": ["{{baseUrl}}"], "path": ["api", "schedules"] },
						"body": { "mode": "raw", "raw": "{\n  \"user\": \"{{userId}}\",\n  \"dayOfWeek\": \"Funday\"\n}" },
						"description": "Verifies the enum validator rejects an invalid day of week."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 400', () => pm.response.to.have.status(400));"
								]
							}
						}
					]
				},
				{
					"name": "[Error] Get Schedule by Nonexistent ID",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/schedules/{{invalidId}}", "host": ["{{baseUrl}}"], "path": ["api", "schedules", "{{invalidId}}"] },
						"description": "Verifies a syntactically valid but nonexistent ObjectId returns 404."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 404', () => pm.response.to.have.status(404));"
								]
							}
						}
					]
				}
			]
		}
	]
}
