							"raw": "{{baseUrl}}/api/exercises?category=Warm-up",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exercises"],
							"query": [ { "key": "category", "value": "Warm-up", "description": "Filter exercises by category enum." } ]
