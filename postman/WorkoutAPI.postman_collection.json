					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
						"description": "Cleanup: deletes the user created earlier."
					}
				},
				{
